# ============================================
# SheetNotify Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ── Database Connection ──
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sheetnotify
# Production (Cloud Run to Cloud SQL):
# DATABASE_URL=postgresql+asyncpg://db_user:db_password@/sheetsnotify?host=/cloudsql/YOUR_PROJECT_ID:us-central1:YOUR_INSTANCE_ID

# ── JWT ──
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-256-bit-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── Google OAuth ──
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Telegram ──
# Get the token from @BotFather. Do NOT commit a real token.
TELEGRAM_BOT_TOKEN=123456:your-bot-token-here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=generate-a-random-token-here

# ── App Config ──
FRONTEND_URL=https://sheet-notify.vercel.app
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# Background polling (default change-detection trigger). Set false to disable.
ENABLE_POLLING=true
POLLING_CYCLE_SECONDS=60
